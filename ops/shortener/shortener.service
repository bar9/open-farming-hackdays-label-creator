# Kurz-Link-Dienst für declarino.ch (/api/shorten, /s/<code>).
#
# Installiert nach /etc/systemd/system/shortener.service. Das Programm liegt
# unter /opt/shortener/ (gehört dem Benutzer deploy, der CI aktualisiert es),
# die Datenbank unter /var/lib/shortener/links.db (gehört dem Benutzer
# shortener, nur dieser darf schreiben).

[Unit]
Description=declarino.ch Kurz-Link-Dienst
After=network.target
# Ohne Programm (frischer Server vor dem ersten Deploy) nicht in einer
# Neustartschleife hängen.
ConditionPathExists=/opt/shortener/shortener

[Service]
Type=simple
User=shortener
Group=shortener
ExecStart=/opt/shortener/shortener serve
Environment=SHORTENER_LISTEN=127.0.0.1:3000
# Legt /var/lib/shortener an (Besitzer shortener) und setzt STATE_DIRECTORY;
# daraus ergibt sich die Datenbank /var/lib/shortener/links.db.
StateDirectory=shortener
StateDirectoryMode=0750
Restart=on-failure
RestartSec=2

# Härtung
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/shortener
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
