# Nächtliche Sicherung der Kurz-Link-Datenbank.
#
# Installiert nach /etc/systemd/system/shortener-backup.service, ausgelöst von
# shortener-backup.timer. `sqlite3 .backup` liest eine konsistente Kopie, auch
# während der Dienst schreibt (WAL). Behalten werden die letzten 14 Kopien.

[Unit]
Description=Sicherung der declarino.ch Kurz-Link-Datenbank
After=shortener.service

[Service]
Type=oneshot
User=shortener
Group=shortener
# /var/backups/shortener legt ops/server-setup.sh an (Besitzer shortener,
# Modus 0700). StateDirectory= taugt hier nicht, es zielt auf /var/lib.
ExecStart=/bin/sh -eu -c '\
  ziel=/var/backups/shortener/links-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).db; \
  sqlite3 /var/lib/shortener/links.db ".backup $ziel"; \
  test "$(sqlite3 "$ziel" "PRAGMA integrity_check")" = ok; \
  echo "Sicherung $ziel: $(sqlite3 "$ziel" "SELECT COUNT(*) FROM links") Links"; \
  ls -1t /var/backups/shortener/links-*.db | tail -n +15 | xargs -r rm -f --'

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ReadWritePaths=/var/backups/shortener
# sqlite3 muss für eine konsistente Kopie den Lese-Lock in links.db-shm
# setzen, deshalb ist auch das Datenverzeichnis schreibbar.
ReadWritePaths=/var/lib/shortener
UMask=0077
